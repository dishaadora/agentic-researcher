# Required for live guide generation. The library works without it.
GROQ_API_KEY=

# Optional. Match this to the tokens-per-minute limit on your Groq account's Limits page.
# Each step's token budget is sized from it.
GROQ_TOKENS_PER_MINUTE=8000

# Optional limits on public generation. Groq's base limit of 200K tokens per day allows only a few runs.
MAX_GENERATIONS_PER_DAY=5
MAX_GENERATIONS_PER_IP_PER_HOUR=5

# Optional. Where generated guides are saved; point it at a persistent volume in production.
DATA_DIR=./data/runtime
